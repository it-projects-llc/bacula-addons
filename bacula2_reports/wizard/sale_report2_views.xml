<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_report2_form" model="ir.ui.view">
        <field name="name">sale.report2.form</field>
        <field name="model">sale.report2</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        string="Make"
                        class="btn btn-primary"
                        type="object"
                        name="action_make_report"
                    />
                    <button string="Cancel" class="btn btn-default" special="cancel" />
                </header>
                <group>
                    <field name="company" />
                    <field name="currency_id" invisible="1" />
                    <field name="period_start" />
                    <field name="period_end" />
                </group>
                <group string="Summary">
                    <field name="opportunities_count_all" />
                    <field name="opportunities_count_lost" />
                    <field name="opportunities_count_won" />
                    <field name="opportunities_emails" />
                </group>
                <group>
                    <field name="pipeline_chart" widget="bokeh_chart" nolabel="1" />
                </group>
            </form>
        </field>
    </record>

    <record id="report_action_show" model="ir.actions.act_window">
        <field name="name">Sales Overview</field>
        <field name="res_model">sale.report2</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="menu_report_action_show"
        action="report_action_show"
        parent="crm.crm_menu_report"
        sequence="100"
        name="Sales Overview"
    />
</odoo>
