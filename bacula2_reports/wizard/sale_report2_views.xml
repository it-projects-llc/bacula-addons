<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_report2_form" model="ir.ui.view">
        <field name="name">sale.report2.form</field>
        <field name="model">sale.report2</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="period" />
                </group>
                <footer>
                    <button string="Cancel" class="btn btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="sale_report2_act_window" model="ir.actions.act_window">
        <field name="name">Sale Report2</field>
        <field name="res_model">sale.report2</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
    </record>
</odoo>
