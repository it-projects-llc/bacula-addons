<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_subscription_pricelist_change_form" model="ir.ui.view">
        <field name="name">sale.subscription.pricelist.change.form</field>
        <field name="model">sale.subscription.pricelist.change</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="subscription" />
                    <field name="new_pricelist" />
                </group>
                <footer>
                    <button
                        string="Change"
                        class="btn btn-primary"
                        name="action_change"
                        type="object"
                    />
                    <button string="Cancel" class="btn btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pricelist_change" model="ir.actions.act_window">
        <field name="name">Change pricelist</field>
        <field name="res_model">sale.subscription.pricelist.change</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order" />
        <field name="binding_view_types">form</field>
    </record>
</odoo>
